# Copier vers .env (non versionné) — frontend Vite
# Renseigner avec les valeurs du dashboard Supabase (Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.remplacer_par_votre_cle_anon

# PRT / eBay (scripts npm run prt:* — lire docs/PRT-EBAY-SETUP.md)
# Clés Application eBay (Production) — depuis developer.ebay.com, jamais committer les vraies clés ici
EBAY_CLIENT_ID=votre_client_id_ebay
EBAY_CLIENT_SECRET=votre_client_secret_ebay
# Optionnel : marché (défaut EBAY_FR, prix en EUR)
# EBAY_MARKETPLACE_ID=EBAY_FR
# Si 0 résultat sur FR, replis automatiques EBAY_DE / EBAY_GB (voir ebay.mjs)
# EBAY_FALLBACK_MARKETPLACES=EBAY_DE,EBAY_GB
# EBAY_DEBUG=1

# WhatsApp Business — indicatif pays SANS + (ex. 22870123456). Obligatoire sur Render : ajouter la variable
# puis REDÉPLOYER le site (Vite injecte VITE_* au moment du build, pas au runtime).
# VITE_WHATSAPP_BUSINESS=228XXXXXXXX

# Scripts PRT (service role uniquement, machine / CI — pas dans le bundle client)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=remplacer_par_service_role_secret

# Optionnel
# PRT_SYNC_DELAY_MS=500
# PRT_MAX_AGE_DAYS=30
# PRT_SYNC_LIMIT=2500
# PRT_SYNC_LIMIT=0   # 0 = tout le catalogue (sync incrémental)
